# Contact info put into the User-Agent (email or URL). REQUIRED by Wikimedia's bot policy.
CRAWLER_CONTACT=

# Optional: Pexels API key (free): https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: Openverse API credentials (higher limits, may avoid the Cloudflare
# challenge anonymous requests from datacenter IPs get). Register with:
#   curl -X POST https://api.openverse.org/v1/auth_tokens/register/ \
#        -H 'Content-Type: application/json' \
#        -d '{"name":"my-image-crawler","description":"personal image sorter","email":"you@example.com"}'
# then click the verification link sent to your email.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Optional: Hugging Face token for faster model downloads
# HF_TOKEN=
